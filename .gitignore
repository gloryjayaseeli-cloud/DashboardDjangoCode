# Django #
############

# Environment variables
# Use a .env file for secrets and settings
.env
.env.*

# Virtual Environment
# Replace 'venv' with the name of your virtual environment folder if different
/venv/
/env/

# Database
# Ignore the local SQLite database
/db.sqlite3
/db.sqlite3-journal

# Python generated files
__pycache__/
*.pyc
*.pyo
*.pyd

# Static and Media files
# The '/static/' directory is often generated by 'collectstatic'
/static/
/media/

# Editor and OS specific files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Log and coverage files
*.log
coverage.xml
.coverage